# ==============================================================================
# Typstr Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:8989
BACKEND_ORIGIN=http://localhost:3000
LOG_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# 2. Security & Session Secrets
# Generate random 32-byte hex strings using: openssl rand -hex 32
# ------------------------------------------------------------------------------
SESSION_SECRET=dev-session-secret-change-in-production
COLLABORATION_SECRET=dev-collab-secret-change-in-production
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-32-chars-min!
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# 3. Database & Cache
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://typstr:typstr@postgres:5432/typstr
SESSION_REDIS_URL=redis://redis:6379/0
COLLABORATION_REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Persistent Storage & Data Directories (Self-Hosting)
# ------------------------------------------------------------------------------
# Root directory for all persistent data in production (default: /prod-data)
PROD_DATA_DIR=/prod-data
# Local document file storage root
LOCAL_FILE_STORAGE=true
LOCAL_STORAGE_ROOT=/app/.local-storage
BACKUP_DIR=

# ------------------------------------------------------------------------------
# 5. LDAP / Active Directory Authentication (Enterprise & Self-Hosting)
# ------------------------------------------------------------------------------
LDAP_ENABLED=true
LDAP_URL=ldap://openldap:389
LDAP_BIND_DN=cn=admin,dc=example,dc=org
LDAP_BIND_PASSWORD=adminpassword
LDAP_SEARCH_BASE=dc=example,dc=org
LDAP_SEARCH_FILTER=(|(mail={{username}})(uid={{username}})(cn={{username}})(sAMAccountName={{username}}))
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_NAME_ATTRIBUTE=cn
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 6. Local Development Auth Bypass
# ------------------------------------------------------------------------------
LOCAL_AUTH_BYPASS=true
LOCAL_AUTH_EMAIL=dev@typstr.local
LOCAL_AUTH_NAME=Local Developer

# ------------------------------------------------------------------------------
# 7. Google OAuth & Drive Workspace (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8989/api/auth/google/callback
GOOGLE_DRIVE_ROOT_NAME=typstr

# ------------------------------------------------------------------------------
# 8. ORCID OAuth (Optional - Academic Profiles)
# ------------------------------------------------------------------------------
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_CALLBACK_URL=http://localhost:8989/api/auth/orcid/callback
ORCID_AUTHORIZE_URL=https://orcid.org/oauth/authorize
ORCID_TOKEN_URL=https://orcid.org/oauth/token

# ------------------------------------------------------------------------------
# 9. AI Writing Assistant (Optional Server-Wide Key)
# Users can also supply their own BYOK keys directly in user settings.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 10. SMTP Email Service (Invitations & Passwordless Links)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Typstr <typstr@arleon.com.tr>

# ------------------------------------------------------------------------------
# 11. Concurrency, Limits & Admin
# ------------------------------------------------------------------------------
ADMIN_EMAILS=
MAX_CONCURRENT_COMPILES=4
REQUEST_BODY_LIMIT_MB=64
TINYMIST_BIN=/usr/local/bin/tinymist
TEXLAB_BIN=/usr/local/bin/texlab
